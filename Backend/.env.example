# TRUSS Backend Production / Local Environment Template
NODE_ENV=production
PORT=5001
TZ=Europe/Istanbul

# PostgreSQL 16 Connection
DATABASE_URL=postgresql://truss_user:REPLACE_STRONG_DB_PASSWORD@127.0.0.1:5432/truss_db

# JWT Signing Key (>= 32 chars, high-entropy random string)
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_CHARS_RANDOM_HIGH_ENTROPY_KEY

# Reverse Proxy & CORS (Production: https:// only, no wildcard, no true)
CORS_ORIGIN=https://app.trussfleet.com
TRUST_PROXY=1

# Document Vault (Production requires s3; local is rejected in production)
DOC_VAULT_DRIVER=s3
S3_ENDPOINT=https://REPLACE_ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=truss-doc-vault
S3_ACCESS_KEY_ID=REPLACE_S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=REPLACE_S3_SECRET_ACCESS_KEY
S3_REGION=auto
DOC_VAULT_LOCAL_DIR=
